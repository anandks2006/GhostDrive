# ─── Credentials & secrets ────────────────────────────────────────────────────
# NEVER commit these to git. They contain your API keys, phone number,
# and Telegram session tokens.

# Telegram MTProto session files
*.session
*.session-journal
ghostdrive_test.session
ghostdrive_integration.session

# Credential files (filled in locally, never committed)
telegram_credentials.py

# Project spec document (internal reference only -- not for public release)
GhostDrive_ProjectSpec_v1.2.txt
GhostDrive_ProjectSpec_*.txt

# GhostDrive keystore (contains your encrypted Master Key)
keystore.json
nonce_counter.json

# Config files that may hold credentials
config.ini
config.json
secrets.json
.env
.env.*
credentials.json

# ─── Telegram index / test artifacts ─────────────────────────────────────────
telegram_index.json
integration_index_*.json
ghosdrive_test_input.bin
ghosdrive_test_output.bin
ghosdrive_integration_*.bin

# Integration test nonce counter storage
.integration_test_data/

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
.Python
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/

# Poetry
poetry.lock        # Uncomment this line to NOT commit lockfile (not recommended)
